<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Authors>Panoramic Data Limited</Authors>
    <PackageProjectUrl>https://github.com/panoramicdata/PanoramicData.Datadog.Api/</PackageProjectUrl>
    <RepositoryUrl>https://github.com/panoramicdata/PanoramicData.Datadog.Api/</RepositoryUrl>
    <Copyright>Copyright © Panoramic Data Limited 2025</Copyright>
    <PackageLicenseUrl></PackageLicenseUrl>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageIcon>Icon.png</PackageIcon>
    <PackageTags>Datadog API REST</PackageTags>
    <PackageId>PanoramicData.Datadog.Api</PackageId>
    <Title>Datadog.Api</Title>
    <Description>A .NET API for Datadog</Description>
    <Summary>A .NET API for Datadog</Summary>
    <Company>Panoramic Data Limited</Company>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <LangVersion>latest</LangVersion>
    <AnalysisMode>All</AnalysisMode>
    <Nullable>enable</Nullable>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <ApplicationIcon>Icon.ico</ApplicationIcon>
    <ImplicitUsings>enable</ImplicitUsings>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <!-- Update the following before releasing to nuget -->
    <PackageReleaseNotes>
      Security fix: sensitive HTTP headers are now redacted in diagnostic output.

      Previously AuthenticatedHttpClientHandler joined every request and response header, key and
      value, into its Debug level log message. The handler adds DD-API-KEY and DD-APPLICATION-KEY to
      each request, so both keys were written verbatim. Any consumer running at Debug retained usable
      credentials for the life of its log store, and neither key expires.

      DD-API-KEY and DD-APPLICATION-KEY are now redacted, along with Authorization,
      Proxy-Authorization, Cookie, Set-Cookie and common API key header names, case-insensitively, on
      request and response. The credential length is retained, so requests remain diagnosable without
      exposing the value. The log line format is otherwise unchanged.

      Consumers should upgrade, review existing Debug logs for previously captured keys, and rotate
      any key that appears in them.

      Filtered endpoints on IMetrics, ITeams and IUsage now take a request object. The old
      optional-parameter overloads still work but are obsolete and will be removed in 3.0; they
      produce byte-identical requests, so migration is mechanical.

      Breaking: GetMetadataAsync and GetRelatedAssetsAsync now require a CancellationToken, matching
      the rest of the library.
    </PackageReleaseNotes>
    <NeutralResourcesLanguage>en</NeutralResourcesLanguage>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Datadog.Api.Test" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Nerdbank.GitVersioning">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Refit" />
  </ItemGroup>
